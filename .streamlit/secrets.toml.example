# Para desenvolvimento local com Streamlit sem Docker.
# Copie este arquivo para secrets.toml e preencha os valores.
# Em Docker ou HF Spaces, use variáveis de ambiente: HF_TOKEN e HF_MODEL

# O modelo precisa ser servido por algum Inference Provider habilitado na sua conta:
# https://huggingface.co/settings/inference-providers
[huggingface]
token = "hf_..."
model = "meta-llama/Llama-3.3-70B-Instruct"

# Opcional. OCR de currículos baseados em imagem.
# tesseract_cmd: caminho do executável do Tesseract (necessário no Windows se não estiver no PATH).
# lang: idioma do OCR (padrão: por).
[ocr]
# tesseract_cmd = "C:\\Program Files\\Tesseract-OCR\\tesseract.exe"
# lang = "por"
